@startuml
!theme plain
skinparam componentStyle rectangle

package "Client Tier (Browser)" {
    component [Angular SPA] as UI
    component [Auth Interceptor] as AuthInterceptor
}

package "Application Server Tier (Node.js / Express)" {
    component [API Router] as Router
    component [Auth Middleware\n(JWT & Sliding Session)] as AuthMW

    package "API Routers & Controllers" {
        component [Auth Router] as AuthRouter
        component [Users Router] as UsersRouter
        component [Ingredients Router] as IngRouter
        component [Recipes Router &\nRecipe Controller] as RecipeCtrl
        component [Meal Plans Router] as MealPlanRouter
        component [Shopping List Router] as ShoppingRouter
    }

    package "Services & Utility Engines" {
        component [NNLS Macro Balancer Engine\n(ml-matrix & nnls)] as Balancer
        component [Gemini AI Client\n(@google/genai)] as GeminiClient
        component [USDA API Client] as USDAClient
        component [Email Dispatch Service\n(Nodemailer)] as EmailService
        component [Ingredient Seeder] as Seeder
    }

    component [Mongoose ODM] as ODM
}

database "Data Tier" {
    component [MongoDB Database] as DB
}

package "External Services" {
    component [Google Gemini AI API] as GeminiAPI
    component [USDA FoodData Central API] as USDAAPI
    component [SMTP Server\n/ Ethereal Sandbox] as SMTPServer
}

' Client Requests
UI --> AuthInterceptor : User Actions
AuthInterceptor --> Router : HTTP REST Requests (/api/*)

' Router & Middleware Routing
Router --> AuthMW : Token Verification
AuthMW --> AuthRouter : /api/auth
AuthMW --> UsersRouter : /api/users
AuthMW --> IngRouter : /api/ingredients
AuthMW --> RecipeCtrl : /api/recipes
AuthMW --> MealPlanRouter : /api/meal-plans
AuthMW --> ShoppingRouter : /api/shopping-list

' Controller to Services & Engines
RecipeCtrl --> Balancer : Triggers Matrix Solver
RecipeCtrl --> GeminiClient : Requests Recipe Gen / Interventions
RecipeCtrl --> USDAClient : Verifies Ingredient Macros
IngRouter --> GeminiClient : Auto-Tags New Ingredients
UsersRouter --> EmailService : Requests Email Verification Link
AuthRouter --> EmailService : Sends Account Verification & Password Resets
Seeder --> ODM : Imports Baseline Ingredients on Boot

' Controllers to Data Tier
AuthRouter --> ODM : Object Method Calls
UsersRouter --> ODM : Object Method Calls
IngRouter --> ODM : Object Method Calls
RecipeCtrl --> ODM : Object Method Calls
MealPlanRouter --> ODM : Object Method Calls
ShoppingRouter --> ODM : Object Method Calls

' External Integration Calls
GeminiClient --> GeminiAPI : HTTPS REST Calls
USDAClient --> USDAAPI : HTTPS REST Calls
EmailService --> SMTPServer : SMTP / TLS Dispatch

' Database Access
ODM --> DB : Native Driver Queries
@endluml