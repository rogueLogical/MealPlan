@startuml
!theme plain
top to bottom direction
skinparam componentStyle rectangle

package "Client Tier (Browser)" {
    component [Angular SPA] as UI
    component [Auth Interceptor] as AuthInterceptor

    'UI -[hidden]down-> AuthInterceptor
}

package "Application Server Tier (Node.js / Express)" {
    component [API Router] as Router
    component [Auth Middleware\n(JWT & Sliding Session)] as AuthMW

    'Router -[hidden]down-> AuthMW

    package "API Routers & Controllers" as Controllers {
        component [Auth Router] as AuthRouter
        component [Users Router] as UsersRouter
        component [Ingredients Router] as IngRouter
        component [Recipes Router &\nController] as RecipeCtrl
        component [Meal Plans Router] as MealPlanRouter
        component [Shopping List Router] as ShoppingRouter

        ' 1-Column Strict Vertical Layout
        RecipeCtrl -[hidden]down-> IngRouter
        IngRouter -[hidden]down-> AuthRouter
        AuthRouter -[hidden]down-> UsersRouter
        UsersRouter -[hidden]down-> MealPlanRouter
        MealPlanRouter -[hidden]down-> ShoppingRouter
    }

    package "Services & Utility Engines" as Engines {
        component [Macro Balancer] as Balancer
        component [Gemini Client] as GeminiClient
        component [Email Service] as EmailService
        component [USDA Client] as USDAClient
        component [Ingredient Seeder] as Seeder

        ' 1-Column Strict Vertical Layout
        Balancer -[hidden]down-> GeminiClient
        GeminiClient -[hidden]down-> USDAClient
        USDAClient -[hidden]down-> EmailService
        EmailService -[hidden]down-> Seeder
    }

    component [Mongoose ODM] as ODM

    'Controllers -[hidden]right-> Engines
    ShoppingRouter -[hidden]down-> ODM

    ' Engines and Controllers to Data Layer
    Controllers -down-> ODM : Mongoose Calls
    Seeder -left-> ODM : Seeds Baseline Ingredients
    'Engines --> ODM
}

package "External Services" {
    component [Google Gemini API] as GeminiAPI
    component [SMTP Mail Server] as SMTPServer
    component [USDA FoodData API] as USDAAPI

    ' 1-Column Strict Vertical Layout
    GeminiAPI -[hidden]down-> USDAAPI
    USDAAPI -[hidden]down-> SMTPServer
}


database "Data Tier" {
    component [MongoDB Database] as DB
}

' Tier-to-Tier Vertical Flow
UI -down-> AuthInterceptor : User Actions
AuthInterceptor --> Router : HTTP REST (/api/*)
Router -down-> AuthMW : Token Verification
AuthMW --> Controllers : Route Dispatch

' Controller to Engine Links
RecipeCtrl --> Balancer : Solve Recipe Matrix
RecipeCtrl --> GeminiClient : AI Gen / Interventions
IngRouter --> USDAClient : Macro Lookups
IngRouter --> GeminiClient : Auto-Tag Ingredients
UsersRouter --> EmailService : Email Verifications
AuthRouter --> EmailService : Password Resets

' Engines and Controllers to Data Layer
'Controllers --> ODM : Mongoose Calls
'Seeder --> ODM : Seeds Baseline
'Engines --> ODM

' External Integrations
GeminiClient --> GeminiAPI : HTTPS REST
USDAClient --> USDAAPI : HTTPS REST
EmailService --> SMTPServer : SMTP / TLS

' Database Connection
ODM --> DB : Native Queries
@endluml